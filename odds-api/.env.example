# Optional discovered ID overrides; built-in name mappings are always used.
UNABATED_BET_TYPE_MAP={}
UNABATED_PERIOD_MAP={}
POLL_INTERVAL=30
ODDS_MIN_INTERVAL=5
COLLECTED_TTL=90
SOURCE_TTL=3600
PROPS_CACHE_TTL=3600
BET365_ENABLED=true
BET365_REGION=nj
BET365_INTERVAL=90
