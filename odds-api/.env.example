STORAGE_BACKEND=redis
# Deployment adds ODDS_REDIS_MODE=local if absent. Set external to retain hosted Redis.
# For manual self-hosted Redis, use the local Compose override.
# ODDS_REDIS_MODE=local
# REDIS_URL=redis://redis:6379/0
REDIS_URL=rediss://default:REPLACE_WITH_PASSWORD@sharpedge-odds-marsh-plume.sage.cloud.layerbase.dev:6379
REDIS_PREFIX=sharpedge:odds:v1
UNABATED_ENABLED=true
UNABATED_ODDS_ENABLED=true
# Product keys are independent from the upstream provider credential.
API_KEYS=replace-with-your-product-key
UNABATED_API_KEY=replace-with-provider-key
# PropLine retrieval probe; one bulk call per league, all books and requested markets.
PROPLINE_API_KEY=
PROPLINE_ENABLED=true
PROPLINE_POLL_INTERVAL=480
PROPLINE_REQUEST_TIMEOUT=90
PROPLINE_COLLECTED_TTL=600
PROPLINE_MAX_AGE=900
LEAGUES_JSON={"nhl_hockey":{"title":"NHL","route":"nhl"},"nba_basketball":{"title":"NBA","route":"nba"},"nfl_football":{"title":"NFL","route":"nfl"},"mlb_baseball":{"title":"MLB","route":"mlb"},"ncaaf_football":{"title":"NCAAF","route":"cfb"}}
# Optional discovered ID overrides; built-in name mappings are always used.
UNABATED_BET_TYPE_MAP={}
UNABATED_PERIOD_MAP={}
POLL_INTERVAL=480
ODDS_MIN_INTERVAL=5
COLLECTED_TTL=600
SOURCE_TTL=3600
PROPS_CACHE_TTL=3600
BET365_ENABLED=false
BET365_REGION=nj
BET365_INTERVAL=90
BET365_MAX_AGE=150
