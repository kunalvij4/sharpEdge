# Local machine only. The server receives the same key through its .env / Actions secret.
BET365_SERVER_URL=https://sharpedge-odds-api.duckdns.org
BET365_INGEST_KEY=replace-with-a-dedicated-random-collector-key
BET365_REGION=nj
BET365_INTERVAL=300
BET365_MAX_AGE=600
BET365_WAIT=4
BET365_COMMAND_TIMEOUT=240
BET365_MAX_PROP_EVENTS=3
BET365_DELIVERY_TIMEOUT=120
COLLECTION_EXCLUDED_LEAGUES=["mlb_baseball"]
