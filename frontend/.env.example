# Copy to .env and fill in your own values. Never put live configuration here.
LAYERBASE_REST_URL=
LAYERBASE_REST_TOKEN=
PORT=4173

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_ID=(default)

# Stripe Checkout (all secrets stay on the server). See STRIPE-SETUP.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GOLD=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_FANTASY=
STRIPE_PRICE_FANTASY_PLUS=
STRIPE_PRICE_PLATINUM=
# Canonical frontend URL; use http://localhost:4173 during local development.
APP_URL=http://localhost:4173
# Service account for trusted billing writes to Firestore.
FIREBASE_CLIENT_EMAIL=
# PKCS#8 PEM private key; a single quoted value with literal \n is supported.
FIREBASE_PRIVATE_KEY=
